{
  "name": "@typescratch/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typescratch": "node packages/cli/src/bin.ts",
    "scaffold": "node packages/cli/src/bin.ts init",
    "build": "pnpm typescratch build --entry examples/hello-native/main.ts --target scratch --out dist/hello.sb3",
    "build:hybrid": "pnpm typescratch build --entry examples/hybrid/main.ts --target turbowarp --out dist/hybrid.sb3",
    "build:showcase": "pnpm typescratch build --entry examples/showcase/main.ts --target scratch --out dist/showcase.sb3",
    "trace:showcase": "node tests/trace-showcase.ts",
    "build:workspace": "pnpm typescratch build --config examples/workspace/tscr.config.json --out dist/workspace.sb3",
    "build:default": "pnpm typescratch build --config packages/workspace/template/tscr.config.json --out dist/default.sb3",
    "build:packages": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshots": "node tests/snapshots.ts",
    "snapshots:update": "node tests/snapshots.ts --update",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint packages/*/src tests examples",
    "verify:vm": "node tests/vm-smoke.ts",
    "verify:e2e": "bash tests/e2e-turbowarp.sh",
    "verify:e2e:frame": "bash tests/e2e-frame-extension.sh",
    "verify": "turbo run //#typecheck //#lint //#test //#snapshots //#verify:vm //#build:packages --concurrency=1 --output-logs=errors-only"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/jsdom": "catalog:",
    "@typescratch/backend-planner": "workspace:*",
    "@typescratch/compiler": "workspace:*",
    "@typescratch/diagnostics": "workspace:*",
    "@typescratch/graph": "workspace:*",
    "@typescratch/ir": "workspace:*",
    "@typescratch/ir-opt": "workspace:*",
    "@typescratch/runtime-abi": "workspace:*",
    "@typescratch/workspace": "workspace:*",
    "@typescratch/testing": "workspace:*",
    "fflate": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "scratch-vm": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
